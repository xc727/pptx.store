{
  "version": 2,
  "rewrites": [
    { "source": "/logo.png", "destination": "/static/brand/logo.png" },
    { "source": "/apple-touch-icon.png", "destination": "/static/brand/logo.png" },
    { "source": "/api/ppt/jobs/:jobId/outline", "destination": "/api/ppt/jobs/outline/:jobId" },
    { "source": "/api/ppt/jobs/:jobId/download/editable-pptx", "destination": "/api/ppt/jobs/download/:jobId" },
    { "source": "/api/ppt/jobs/:jobId/download/recovery-pptx", "destination": "/api/ppt/jobs/recovery/:jobId" },
    { "source": "/api/ppt/jobs/:jobId/slides/1/source", "destination": "/api/ppt/jobs/source/:jobId" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/workbench", "destination": "/workbench.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/preview-editor", "destination": "/preview_editor.html" },
    { "source": "/ppt-editor", "destination": "/ppt_editor.html" },
    { "source": "/editable-workbench", "destination": "/editable_workbench.html" },
    { "source": "/image-to-editable", "destination": "/image_to_editable.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
